{
  "name": "conductor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Host-neutral Conductor domain: symphonies, agents, profiles, harness readers, and the task-agent command server.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "22.19.15",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "zod": "4.4.3"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
