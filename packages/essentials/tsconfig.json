{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "zod": ["./node_modules/zod", "../../bb/essentials/node_modules/zod"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
