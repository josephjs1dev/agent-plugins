{
  "name": "bb-plugin-conductor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn an approved plan into a symphony of bb task threads and follow the work to completion.",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Conductor [Experimental]",
    "description": "Turn an approved plan into a symphony of task threads, dispatch them, and follow their reports to completion.",
    "branding": {
      "icon": "Workflow"
    },
    "server": "./server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "conductor": "file:../../packages/conductor",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.15",
    "better-sqlite3": "12.4.1",
    "cron-parser": "5.5.0",
    "eslint": "9.39.1",
    "hono": "4.11.9",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  }
}
