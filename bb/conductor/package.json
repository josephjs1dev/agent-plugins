{
  "name": "bb-plugin-conductor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn an approved plan into a symphony of bb task threads and follow the work to completion.",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Conductor [Experimental]",
    "description": "Turn an approved plan into a symphony of task threads, dispatch them, and follow their reports to completion.",
    "branding": {
      "icon": "Workflow"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "conductor": "file:../../packages/conductor",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "better-sqlite3": "12.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cron-parser": "5.5.0",
    "eslint": "9.39.1",
    "hono": "4.13.13",
    "prettier": "3.6.2",
    "sonner": "1.7.4",
    "tailwind-merge": "3.7.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vaul": "1.1.2"
  }
}
