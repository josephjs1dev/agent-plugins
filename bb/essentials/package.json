{
  "name": "bb-plugin-essentials",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Subscription limits, token history, workspace usage, context-window reminders, child-thread cleanup, and a workspace file explorer for bb.",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Essentials",
    "description": "Subscription limits, token history, workspace usage, context-window reminders, child-thread cleanup, and a workspace file explorer.",
    "branding": {
      "icon": "./assets/icon.svg",
      "experimental_icons": {
        "gauge": "./assets/icons/gauge.svg",
        "chart": "./assets/icons/chart.svg",
        "refresh": "./assets/icons/refresh.svg",
        "alarm": "./assets/icons/alarm.svg",
        "reset": "./assets/icons/reset.svg",
        "archive": "./assets/icons/archive.svg",
        "trash": "./assets/icons/trash.svg",
        "folder": "./assets/icons/folder.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "essentials": "file:../../packages/essentials",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "better-sqlite3": "12.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cron-parser": "5.5.0",
    "eslint": "9.39.1",
    "hono": "4.11.9",
    "prettier": "3.6.2",
    "sonner": "1.7.4",
    "tailwind-merge": "3.7.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vaul": "1.1.2"
  }
}
